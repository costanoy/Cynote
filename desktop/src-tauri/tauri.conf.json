{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cynote",
  "version": "0.1.29",
  "identifier": "com.cynote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cynote",
        "width": 643,
        "height": 523,
        "x": 894,
        "y": 298,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": false,
        "visible": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["icons/dashboard.ico"],
    "fileAssociations": [
      {
        "ext": ["cyte"],
        "name": "Nota Cynote",
        "description": "Nota Cynote",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2NkQ0M0RFNUIyNDdDOTAKUldTUWZDUmIza050eGpPd1psMHJ1NS91MDBqdUpMY0dURG16YXoxUktLc1FZN2lyZXQ5Nnp4TGUK",
      "endpoints": ["https://github.com/costanoy/Cynote/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
